{
  "builds": [
    {
      "src": "app/backend/main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "app/frontend/**",
          "models/**",
          "data/**",
          "src/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/backend/main.py"
    }
  ]
}
