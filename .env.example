# ==============================================================================
# PhishGuard Enterprise Cybersecurity Platform
# Environment Configuration Template (.env.example)
# Copy to .env and adjust configuration for your deployment target.
# ==============================================================================

# Server Environment & Network Binding
PHISHGUARD_ENV=production
PHISHGUARD_HOST=0.0.0.0
PHISHGUARD_PORT=8000
PHISHGUARD_DEBUG=false

# Security & Rate Limiting
# Maximum allowable scan requests per IP per minute (default: 120)
PHISHGUARD_RATE_LIMIT=120

# Persistence & Storage
PHISHGUARD_DB_PATH=data/phishguard.db

# Hybrid Detection Engine Default Weights (Must sum to 1.0)
DEFAULT_WEIGHT_RULES=0.35
DEFAULT_WEIGHT_ML=0.45
DEFAULT_WEIGHT_INTEL=0.20

# Feature Extraction & Passive Analysis
PASSIVE_INSPECTION_ONLY=true
FEATURE_EXTRACTION_TIMEOUT=0.8

# Optional External Threat Feeds / API Keys (if integrating third-party intelligence)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
ABUSEIPDB_API_KEY=
